# Variables à renseigner dans Dokploy (onglet Environment du service Compose).

# Mot de passe de la base Postgres (utilisé par le conteneur db ET l'app). Générer : openssl rand -hex 24
DB_PASSWORD=""

# Secret de signature des sessions admin. Générer : openssl rand -hex 32
SESSION_SECRET=""


# --- Connexion Discord (obligatoire : c'est le seul moyen de se connecter à l'admin) ---
# Application Discord : https://discord.com/developers/applications → OAuth2
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Serveur Discord dont il faut être membre (clic droit sur le serveur → Copier l'identifiant)
DISCORD_GUILD_ID=""
# IDs des rôles autorisés, séparés par des virgules : il faut en avoir AU MOINS UN (vide = tout membre du serveur)
DISCORD_ALLOWED_ROLES=""

# URL publique du site, sans / final (sert à construire l'URL de retour Discord)
APP_URL="https://carte.exemple.fr"
