# Base Postgres locale : `pnpm db:up` (voir docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/webmap"
SESSION_SECRET="générer avec: openssl rand -hex 32"

# --- Connexion Discord (obligatoire : c'est le seul moyen de se connecter à l'admin) ---
# Application Discord : https://discord.com/developers/applications → OAuth2
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
# Serveur Discord dont il faut être membre (clic droit sur le serveur → Copier l'identifiant)
DISCORD_GUILD_ID=""
# IDs des rôles autorisés, séparés par des virgules : il faut en avoir AU MOINS UN (vide = tout membre du serveur)
DISCORD_ALLOWED_ROLES=""
# URL publique (optionnel en local)
APP_URL="http://localhost:3000"
