# Copier en .env et remplir. Aucune de ces valeurs ne doit être commitée.

# Adresse publique du site, sans barre finale (sert aux redirections et à l'URL de retour Discord)
SITE_URL="http://localhost:3000"

# Port d'écoute (le site écoute sur 127.0.0.1:PORT avec `pnpm start`)
PORT=3000

# Connexion à la base PostgreSQL. En local : `pnpm db:up` (Docker, port 5433)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/webmap"

# Secret de chiffrement des sessions admin (32 octets aléatoires). Générer : openssl rand -hex 32
SESSION_SECRET=""

# --- Connexion Discord (seul moyen de se connecter à l'admin) ---
# Application Discord (fournie par l'opérateur). Callback à déclarer : <SITE_URL>/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Serveur Discord dont il faut être membre (Discord en mode développeur → clic droit → Copier l'identifiant)
DISCORD_GUILD_ID=""
# IDs des rôles autorisés, séparés par des virgules : il faut en avoir AU MOINS UN (vide = tout membre du serveur)
DISCORD_ALLOWED_ROLES=""
