generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Zone colorée dessinée sur la carte. `points` = JSON [[x,y],...] en coordonnées SVG.
model Zone {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  category    String   @default("")
  color       String   @default("#22c55e")
  fillOpacity Float    @default(0.35)
  strokeWidth Float    @default(3)
  dashed      Boolean  @default(false)
  points      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Icône placée sur la carte (x,y en coordonnées SVG).
model Marker {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  type        String   @default("house")
  /// "Garage lié" (garages et immeubles uniquement)
  linkedGarage Boolean @default(false)
  x           Float
  y           Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String // CREATE | UPDATE | DELETE | REVERT
  entityType String // ZONE | MARKER
  entityId   String
  actor      String
  before     String? // JSON snapshot
  after      String? // JSON snapshot
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
